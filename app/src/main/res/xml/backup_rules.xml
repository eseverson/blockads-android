<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for API 30 and below (API 31+ uses data_extraction_rules.xml).
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- WireGuard profiles carry private and preshared keys. A restore keeps the routing mode but no profile, so the
         user re-imports. -->
    <exclude domain="file" path="datastore/blockads_wg_secrets.preferences_pb" />
</full-backup-content>
