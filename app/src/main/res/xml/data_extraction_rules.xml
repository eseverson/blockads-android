<?xml version="1.0" encoding="utf-8"?><!--
   Backup and transfer rules for API 31+.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <!-- WireGuard profiles and keys: see backup_rules.xml. -->
    <cloud-backup>
        <exclude domain="file" path="datastore/blockads_wg_secrets.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/blockads_wg_secrets.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
